# =============================================================================
# RADIANZA / SPIHER SUPABASE & RAZORPAY CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# 1. Supabase Project URL (Public URI)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous / Public API Key (anon key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Supabase Service Role Key (Secret Key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 4. Razorpay Payment Gateway (Public Key ID Only - starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
